# Required for the agent loop + re-ranking (Day 2)
GEMINI_API_KEY=
# Used as the polite-pool contact for arXiv/OpenAlex/Crossref and REQUIRED by Unpaywall
CONTACT_EMAIL=you@example.com
# Strongly recommended: keyless Semantic Scholar is a shared pool that 429s constantly.
# Free key: https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=
# Optional: OpenAlex fallback works keyless but has a tiny shared daily budget
OPENALEX_API_KEY=
# Optional: Browserbase Fetch API reads publisher landing pages (inspect_publisher, TC3 evidence)
BROWSERBASE_API_KEY=
# Optional: Browserbase project (inferred from the key if empty)
BROWSERBASE_PROJECT_ID=
# Paths
CITESCOUT_DB=citescout.db
HTTP_CACHE_PATH=.cache/http_cache.sqlite
# Gemini model (2.5 models are restricted for new projects since Sep 2026)
GEMINI_MODEL=gemini-3.8-flash